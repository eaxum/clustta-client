<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.clustta.clustta</id>
  <metadata_license>FSFAP</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>
  <name>Clustta</name>
  <summary>Version control for creative work</summary>
  <developer id="com.clustta">
    <name>Eaxum</name>
  </developer>

  <description>
    <p>
      Clustta simplifies file management, collaboration and version control for creative workflows.
      It provides a familiar, intuitive interface for managing assets, tracking changes, and collaborating
      with your team - designed specifically for creative professionals working with large files.
    </p>
    <p>Features include:</p>
    <ul>
      <li>Version control optimised for large binary files (images, video, audio, 3D models)</li>
      <li>Visual asset browsing with thumbnails and metadata</li>
      <li>Checkpoint-based history - save, compare, and restore any version</li>
      <li>Real-time collaboration with studio teams</li>
      <li>Organise assets with collections, tags, and dependencies</li>
      <li>Works offline - sync when you're ready</li>
    </ul>
  </description>

  <launchable type="desktop-id">com.clustta.clustta.desktop</launchable>

  <url type="homepage">https://clustta.com</url>
  <url type="help">https://docs.clustta.com</url>
  <url type="vcs-browser">https://github.com/eaxum/clustta-client</url>

