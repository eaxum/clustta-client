{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "cross-env VITE_PLATFORM=web vite",
    "dev:dashboard": "cross-env VITE_PLATFORM=web VITE_API_URL=http://localhost:5000 vite",
    "live:dashboard": "cross-env VITE_PLATFORM=web VITE_API_URL=https://api.clustta.com vite",
    "build:dev": "vite build --minify false --mode development",
    "build": "vite build --mode production",
    "build:web": "cross-env VITE_PLATFORM=web vite build --mode production",
    "build:dashboard": "cross-env VITE_PLATFORM=web vite build --mode production",
    "preview": "vite preview",
    "preview:web": "cross-env VITE_PLATFORM=web vite preview",
    "proto:generate": "pbjs -t static-module -w es6 -o src/protos/example.js src/protos/example.proto && pbts -o src/protos/example.d.ts src/protos/example.js"
  },
  "dependencies": {
    "@clustta/icons-vue": "0.1.1",
    "@clustta/web-adapters": "file:../../clustta-app/packages/web-adapters",
    "@dagrejs/dagre": "^1.1.4",
    "@dicebear/big-smile": "^9.3.2",
    "@dicebear/core": "^9.4.1",
    "@vue-flow/background": "^1.3.0",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/core": "^1.41.0",
    "@vue-flow/minimap": "^1.5.0",
    "buffer": "^6.0.3",
    "cropperjs": "^1.6.2",
    "fzstd": "^0.1.1",
    "mitt": "^3.0.1",
    "pako": "^2.1.0",
    "pinia": "^2.1.7",
    "postcss": "8.5.10",
    "protobufjs": "7.5.5",
    "sql.js": "^1.13.0",
    "uuid": "^11.1.0",
    "vue": "^3.3.4",
    "vue-advanced-cropper": "^2.8.8",
    "vue-cropperjs": "^5.0.0",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "@wailsio/runtime": "^3.0.0-alpha.78",
    "cross-env": "^10.1.0",
    "vite": "^5.4.21"
  }
}
